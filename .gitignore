# local-only: symlink to npx playwright cache for E2E scripts
/node_modules
# Screenshot capture output (review copies; the real ones go to the directory repo)
/scripts/screenshots/out/
# Git hosting P1 overlay: broker env file (Forgejo admin token)
testing/git/.env
# Git hosting P1 overlay: the two directional HMAC secrets (GH-07), held by the broker and kb-suite
testing/git/hmac.env
# Git hosting P1 overlay: scenario.sh credentials (Kanboard API key, agent API token)
testing/git/scenario.env
# Git hosting P1 overlay: Authentik secrets (secret key, akadmin password/API token, OIDC client secrets)
testing/git/authentik.env
# Git hosting P1 overlay: third-party code fetched at a pinned commit (testing/git/fetch-oauth2.sh)
testing/git/vendor/
# Git hosting P1 overlay: dev CI runner registration secret (written by bootstrap.sh)
testing/git/runner.env
# Task 16: the CI test secret, and the runners' pinned downloads, VM disks and secrets.
testing/git/ci-secret.env
testing/git/runners/.cache/
# Git hosting P1 overlay: scenario.sh's Forgejo API token of the test human (high-risk approver)
testing/git/scenario-human.token
