# Option (c): KVM-isolated jobs. Kata Containers (QEMU hypervisor) as the default Docker runtime
# of a local QEMU/KVM VM, so every job container is its own microVM: nested KVM (L1 runner VM,
# L2 job VM). This host gives no root, so Kata cannot run on it directly; production would run
# Kata (or Firecracker) on a host whose /dev/kvm is usable (open MVP question for the VPS type).
# Read by ../vm.sh.
VM_NAME=kb-ci-c
VM_LABEL=kvm-kata
# The L2 job VM gets Kata's 2 GiB base plus the job's 4 GiB, hot-plugged.
VM_MEM=9216
VM_CPUS=4
VM_DISK=16G
# Debug ssh, host 127.0.0.1 only: bash testing/git/runners/vm.sh ssh c-kvm
VM_SSH_PORT=2243
VM_ARTIFACTS="runner kata"
