# Option (a): a separate kernel (a local QEMU/KVM VM on the same physical host, ruling F15) with
# Docker and gVisor (runsc) as its default runtime. Read by ../vm.sh.
VM_NAME=kb-ci-a
VM_LABEL=vm-gvisor
VM_MEM=6144
VM_CPUS=4
VM_DISK=10G
# Debug ssh, host 127.0.0.1 only: bash testing/git/runners/vm.sh ssh a-vm-gvisor
VM_SSH_PORT=2241
VM_ARTIFACTS="runner runsc"
